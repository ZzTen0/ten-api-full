# Copy this file to .env before running Docker Compose.
# Use long, unique values on the server and never commit the real .env file.

MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_DATABASE=ten_api
MYSQL_USER=ten_api
MYSQL_PASSWORD=replace_with_a_strong_app_password
REDIS_PASSWORD=replace_with_a_strong_redis_password

HTTP_PORT=80

# Optional JVM overrides for a 4-core / 8-GB host.
BACKEND_JAVA_OPTS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
GATEWAY_JAVA_OPTS=-Xms192m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=128m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
INTERFACE_JAVA_OPTS=-Xms192m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
